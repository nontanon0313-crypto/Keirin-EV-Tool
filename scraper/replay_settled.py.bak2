#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""確定レースを1件ずつ再投票→結果再検証（進捗表示）。

  python3 scraper/replay_settled.py
  python3 scraper/replay_settled.py --since all --limit 5000
"""
from __future__ import annotations

import argparse
import json
import os
import sys
import time
from datetime import datetime

import requests

API = os.environ.get("API_BASE", "https://keirin-ev-tool.onrender.com").rstrip("/")


def log(msg: str) -> None:
    print(f"[{datetime.now().strftime('%H:%M:%S')}] {msg}", flush=True)


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("--since", default="all", help="all=全確定レース / calibration_switch / ISO")
    ap.add_argument("--limit", type=int, default=5000)
    ap.add_argument("--bankroll", type=float, default=1_000_000)
    ap.add_argument("--race-ids", default="", help="カンマ区切り。指定時は対象一覧APIを使わない")
    args = ap.parse_args()

    if args.race_ids.strip():
        ids = [int(x) for x in args.race_ids.split(",") if x.strip()]
    else:
        params = {
            "since": args.since or "all",
            "limit": args.limit,
        }

        log(f"対象一覧取得 {API}/races/replay-settled/targets ...")
        r = requests.get(
            f"{API}/races/replay-settled/targets",
            params=params,
            timeout=120,
        )
        r.raise_for_status()

        data = r.json()
        ids = data.get("race_ids") or []
        log(f"対象 {len(ids)} 件 (since={data.get('since')})")

    if not ids:
        log("対象0件。終了")
        return 0

    log(
        f"旧Purchase/SkippedBetを削除してから"
        f"現行race-planで {len(ids)} 件を再投票します..."
    )

    payload = {
        "race_ids": ids,
        "limit": len(ids),
        "bankroll": args.bankroll,
    }

    t0 = time.time()

    try:
        rr = requests.post(
            f"{API}/races/replay-settled/batch",
            json=payload,
            timeout=max(1800, len(ids) * 30),
        )
        rr.raise_for_status()
        body = rr.json()
    except Exception as e:
        log(f"バッチ再投票APIエラー: {e}")
        return 1

    elapsed = time.time() - t0

    log(
        "旧データ削除: "
        f"Purchase={body.get('old_purchases_deleted', 0)} "
        f"SkippedBet={body.get('old_skipped_bets_deleted', 0)}"
    )

    log(
        "再投票完了: "
        f"total={body.get('total', 0)} "
        f"done={body.get('done', 0)} "
        f"failed_or_skipped={body.get('failed_or_skipped', 0)} "
        f"{elapsed:.0f}s"
    )

    failed = body.get("failed_or_skipped", 0)

    # 詳細結果を表示
    for item in body.get("results") or []:
        rid = item.get("race_id")
        stage = item.get("stage")

        if stage == "done":
            log(
                f"race_id={rid} done "
                f"items={item.get('plan_items')} "
                f"buy={item.get('purchases_recorded')}"
            )
        elif stage and stage.startswith("skipped"):
            log(
                f"race_id={rid} {stage} "
                f"{item.get('message', '')}"
            )
        else:
            log(
                f"race_id={rid} ERROR "
                f"{item.get('error', item)}"
            )

    return 0 if failed == 0 else 1


if __name__ == "__main__":
    sys.exit(main())
