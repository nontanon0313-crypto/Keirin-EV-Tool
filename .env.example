# 主系DB (現状 Neon など)
DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/dbname?sslmode=require

# 副系DB (Neon制限時の自動切替先。推奨: Supabase)
# Supabase: Project Settings → Database → Connection string (URI) を貼る
# 例: postgresql://postgres.xxxx:PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres
DATABASE_URL_FALLBACK=

# 起動時の優先: primary | fallback (省略時 primary)
DATABASE_PREFER=primary

GEMINI_API_KEY=your_gemini_api_key_here
